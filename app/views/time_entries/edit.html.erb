<% content_for :title, "Edit hours · AERO Task Hub" %>

<div class="page-heading">
  <div>
    <p class="eyebrow"><%= @time_entry.task.title %></p>
    <h1>Correct hours</h1>
  </div>
</div>

<%= form_with model: @time_entry, class: "panel task-form", html: { novalidate: true } do |form| %>
  <div class="form-grid">
    <div class="field">
      <%= form.label :hours %>
      <% hours_errors = %i[hours base].select { |attribute| @time_entry.errors[attribute].any? } %>
      <%= form.text_field :hours, inputmode: "decimal", autocomplete: "off", required: true,
                          aria: (hours_errors.any? ? { describedby: hours_errors.map { |attribute| field_error_id(@time_entry, attribute) }.join(" "), invalid: true } : {}) %>
      <%= field_error(@time_entry, :hours) %>
      <%= field_error(@time_entry, :base) %>
    </div>
    <div class="field">
      <%= form.label :worked_on, "Date worked" %>
      <%= form.date_field :worked_on, required: true, **field_error_attributes(@time_entry, :worked_on) %>
      <%= field_error(@time_entry, :worked_on) %>
    </div>
  </div>
  <div class="field">
    <%= form.label :note, "Note (optional)" %>
    <%= form.text_field :note %>
  </div>
  <div class="form-actions">
    <%= form.submit "Save hours", class: "button" %>
    <%= link_to "Cancel", task_path(@time_entry.task), class: "button button-secondary" %>
  </div>
<% end %>
