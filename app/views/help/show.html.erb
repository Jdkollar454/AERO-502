<% content_for :title, "#{@guide.label} · AERO Task Hub" %>

<%# One tab per guide the signed-in role may read; members and signed-out visitors see the member guide only. %>
<nav class="guide-tabs" aria-label="Help guides">
  <% @guides.each do |guide| %>
    <%= link_to guide.label, help_path(guide: guide.key), class: "guide-tab", aria: { current: (guide == @guide ? "page" : nil) } %>
  <% end %>
  <% if current_user&.chief_engineer? %>
    <%= link_to "Download restart PDF", restart_guide_path, class: "button button-secondary button-small guide-download" %>
  <% end %>
</nav>

<article class="panel guide">
  <%= sanitize @guide_html, tags: %w[h1 h2 h3 p ul ol li strong em code pre a table thead tbody tr th td blockquote],
                            attributes: %w[href id] %>
</article>
